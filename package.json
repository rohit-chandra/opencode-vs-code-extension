{
  "name": "opencode-hub",
  "displayName": "OpenCode Hub — BYOK AI Chat",
  "description": "Open-source chat for VS Code that works with opencode first, plus Claude Code, Codex (ChatGPT), GitHub Copilot and any OpenAI-compatible or Anthropic model with your own keys. Sessions, /commands, file attachments, MCP toggles, token usage stats and a 3D companion.",
  "version": "0.5.1",
  "publisher": "rohit-chandra",
  "license": "MIT",
  "private": true,
  "pricing": "Free",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohit-chandra/opencode-vs-code-extension.git"
  },
  "bugs": {
    "url": "https://github.com/rohit-chandra/opencode-vs-code-extension/issues"
  },
  "homepage": "https://github.com/rohit-chandra/opencode-vs-code-extension#readme",
  "qna": "https://github.com/rohit-chandra/opencode-vs-code-extension/issues",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0f1220",
    "theme": "dark"
  },
  "keywords": [
    "opencode",
    "ai",
    "chat",
    "byok",
    "claude code",
    "codex",
    "copilot",
    "mcp",
    "ollama",
    "openrouter"
  ],
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "engines": {
    "vscode": "^1.98.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:opencodeHub.chatPanel"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Agents can read files and run tools, and engine settings can point at executables. In an untrusted workspace no engine is started, chat is disabled, and workspace-level engine settings are ignored.",
      "restrictedConfigurations": [
        "opencodeHub.opencode.path",
        "opencodeHub.opencode.serverUrl",
        "opencodeHub.opencode.serverPassword",
        "opencodeHub.claudeCode.path",
        "opencodeHub.claudeCode.permissionMode",
        "opencodeHub.claudeCode.auth",
        "opencodeHub.codex.path",
        "opencodeHub.codex.sandbox",
        "opencodeHub.codex.auth",
        "opencodeHub.providers",
        "opencodeHub.mcp.servers",
        "opencodeHub.systemPrompt",
        "opencodeHub.defaultEngine"
      ]
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencodeHub",
          "title": "OpenCode Hub",
          "icon": "media/activity.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "opencodeHubSecondary",
          "title": "OpenCode Hub",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "opencodeHub": [
        {
          "id": "opencodeHub.chat",
          "name": "Chat",
          "type": "webview",
          "icon": "media/activity.svg",
          "contextualTitle": "OpenCode Hub"
        }
      ]
    },
    "commands": [
      {
        "command": "opencodeHub.focus",
        "title": "Open Chat",
        "category": "OpenCode Hub",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "opencodeHub.newSession",
        "title": "New Session",
        "category": "OpenCode Hub",
        "icon": "$(add)"
      },
      {
        "command": "opencodeHub.switchSession",
        "title": "Switch Session…",
        "category": "OpenCode Hub",
        "icon": "$(history)"
      },
      {
        "command": "opencodeHub.selectEngine",
        "title": "Select Engine…",
        "category": "OpenCode Hub",
        "icon": "$(server-process)"
      },
      {
        "command": "opencodeHub.selectModel",
        "title": "Select Model…",
        "category": "OpenCode Hub"
      },
      {
        "command": "opencodeHub.toggleAutoMode",
        "title": "Toggle Auto Mode (Proceed Without Asking)",
        "category": "OpenCode Hub",
        "icon": "$(zap)"
      },
      {
        "command": "opencodeHub.signIn",
        "title": "Sign In / Manage Account (Claude, ChatGPT)…",
        "category": "OpenCode Hub",
        "icon": "$(account)"
      },
      {
        "command": "opencodeHub.manageProviders",
        "title": "Manage BYOK Providers & API Keys…",
        "category": "OpenCode Hub",
        "icon": "$(key)"
      },
      {
        "command": "opencodeHub.showMcp",
        "title": "Show MCP Servers",
        "category": "OpenCode Hub",
        "icon": "$(plug)"
      },
      {
        "command": "opencodeHub.showUsage",
        "title": "Show Token Usage",
        "category": "OpenCode Hub",
        "icon": "$(graph)"
      },
      {
        "command": "opencodeHub.resetUsage",
        "title": "Reset Token Usage Statistics",
        "category": "OpenCode Hub"
      },
      {
        "command": "opencodeHub.attachActiveFile",
        "title": "Attach Active File to Chat",
        "category": "OpenCode Hub"
      },
      {
        "command": "opencodeHub.attachSelection",
        "title": "Add Selection to Chat",
        "category": "OpenCode Hub"
      },
      {
        "command": "opencodeHub.attachFiles",
        "title": "Attach Files to Chat…",
        "category": "OpenCode Hub"
      },
      {
        "command": "opencodeHub.explainSelection",
        "title": "Explain Selection",
        "category": "OpenCode Hub"
      },
      {
        "command": "opencodeHub.fixSelection",
        "title": "Fix Selection",
        "category": "OpenCode Hub"
      },
      {
        "command": "opencodeHub.toggleAvatar",
        "title": "Toggle 3D Companion",
        "category": "OpenCode Hub"
      },
      {
        "command": "opencodeHub.restartEngine",
        "title": "Restart Active Engine",
        "category": "OpenCode Hub"
      },
      {
        "command": "opencodeHub.showLogs",
        "title": "Show Logs",
        "category": "OpenCode Hub"
      },
      {
        "command": "opencodeHub.getStarted",
        "title": "Get Started",
        "category": "OpenCode Hub",
        "icon": "$(rocket)"
      },
      {
        "command": "opencodeHub.sendFeedback",
        "title": "Send Feedback or Report a Problem…",
        "category": "OpenCode Hub",
        "icon": "$(feedback)"
      },
      {
        "command": "opencodeHub.doctor",
        "title": "Run Doctor (Check Engines and Environment)",
        "category": "OpenCode Hub",
        "icon": "$(pulse)"
      },
      {
        "command": "opencodeHub.abort",
        "title": "Stop Response",
        "category": "OpenCode Hub"
      },
      {
        "command": "opencodeHub.moveToRight",
        "title": "Move Chat to the Right (Secondary Side Bar)",
        "category": "OpenCode Hub",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "opencodeHub.moveToLeft",
        "title": "Move Chat to the Left (Primary Side Bar)",
        "category": "OpenCode Hub",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "opencodeHub.openInEditor",
        "title": "Open Chat in an Editor Tab",
        "category": "OpenCode Hub",
        "icon": "$(open-preview)"
      },
      {
        "command": "opencodeHub.zoomIn",
        "title": "Increase Chat Text Size",
        "category": "OpenCode Hub"
      },
      {
        "command": "opencodeHub.zoomOut",
        "title": "Decrease Chat Text Size",
        "category": "OpenCode Hub"
      },
      {
        "command": "opencodeHub.zoomReset",
        "title": "Reset Chat Text Size",
        "category": "OpenCode Hub"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "opencodeHub.openInEditor",
          "when": "view == opencodeHub.chat",
          "group": "navigation@9"
        },
        {
          "command": "opencodeHub.selectEngine",
          "when": "view == opencodeHub.chat",
          "group": "1_engine@1"
        },
        {
          "command": "opencodeHub.signIn",
          "when": "view == opencodeHub.chat",
          "group": "1_engine@2"
        },
        {
          "command": "opencodeHub.manageProviders",
          "when": "view == opencodeHub.chat",
          "group": "1_engine@2"
        },
        {
          "command": "opencodeHub.restartEngine",
          "when": "view == opencodeHub.chat",
          "group": "1_engine@3"
        },
        {
          "command": "opencodeHub.toggleAvatar",
          "when": "view == opencodeHub.chat",
          "group": "2_view@1"
        },
        {
          "command": "opencodeHub.showLogs",
          "when": "view == opencodeHub.chat",
          "group": "2_view@2"
        },
        {
          "command": "opencodeHub.moveToRight",
          "when": "view == opencodeHub.chat",
          "group": "0_layout@1"
        },
        {
          "command": "opencodeHub.moveToLeft",
          "when": "view == opencodeHub.chat",
          "group": "0_layout@2"
        },
        {
          "command": "opencodeHub.zoomIn",
          "when": "view == opencodeHub.chat",
          "group": "3_zoom@1"
        },
        {
          "command": "opencodeHub.zoomOut",
          "when": "view == opencodeHub.chat",
          "group": "3_zoom@2"
        },
        {
          "command": "opencodeHub.zoomReset",
          "when": "view == opencodeHub.chat",
          "group": "3_zoom@3"
        },
        {
          "command": "opencodeHub.doctor",
          "when": "view == opencodeHub.chat",
          "group": "4_help@1"
        },
        {
          "command": "opencodeHub.sendFeedback",
          "when": "view == opencodeHub.chat",
          "group": "4_help@2"
        },
        {
          "command": "opencodeHub.getStarted",
          "when": "view == opencodeHub.chat",
          "group": "4_help@0"
        }
      ],
      "editor/context": [
        {
          "command": "opencodeHub.explainSelection",
          "when": "editorHasSelection",
          "group": "opencodeHub@0"
        },
        {
          "command": "opencodeHub.fixSelection",
          "when": "editorHasSelection && !editorReadonly",
          "group": "opencodeHub@0"
        },
        {
          "command": "opencodeHub.attachSelection",
          "when": "editorHasSelection",
          "group": "opencodeHub@1"
        },
        {
          "command": "opencodeHub.attachActiveFile",
          "group": "opencodeHub@2"
        }
      ],
      "explorer/context": [
        {
          "command": "opencodeHub.attachFiles",
          "group": "opencodeHub@1"
        }
      ],
      "commandPalette": [
        {
          "command": "opencodeHub.explainSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "opencodeHub.fixSelection",
          "when": "editorHasSelection"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencodeHub.focus",
        "key": "ctrl+alt+o",
        "mac": "cmd+alt+o"
      },
      {
        "command": "opencodeHub.attachSelection",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorHasSelection"
      },
      {
        "command": "opencodeHub.newSession",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "focusedView == opencodeHub.chat"
      },
      {
        "command": "opencodeHub.zoomIn",
        "key": "ctrl+alt+=",
        "mac": "cmd+alt+=",
        "when": "focusedView == opencodeHub.chat || activeWebviewPanelId == opencodeHub.chatPanel"
      },
      {
        "command": "opencodeHub.zoomOut",
        "key": "ctrl+alt+-",
        "mac": "cmd+alt+-",
        "when": "focusedView == opencodeHub.chat || activeWebviewPanelId == opencodeHub.chatPanel"
      },
      {
        "command": "opencodeHub.zoomReset",
        "key": "ctrl+alt+0",
        "mac": "cmd+alt+0",
        "when": "focusedView == opencodeHub.chat || activeWebviewPanelId == opencodeHub.chatPanel"
      }
    ],
    "configuration": {
      "title": "OpenCode Hub",
      "properties": {
        "opencodeHub.defaultEngine": {
          "type": "string",
          "enum": [
            "opencode",
            "direct",
            "claude-code",
            "codex",
            "vscode-lm"
          ],
          "enumDescriptions": [
            "opencode server (recommended): every opencode provider, agents, commands and MCP.",
            "Direct BYOK: call OpenAI-compatible or Anthropic APIs with your own keys.",
            "Claude Code CLI (uses your Claude login).",
            "Codex CLI (uses your ChatGPT login).",
            "VS Code Language Models (GitHub Copilot and models from other extensions)."
          ],
          "default": "opencode",
          "description": "Engine used for new chat sessions."
        },
        "opencodeHub.opencode.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `opencode` executable. Leave empty to find it on `PATH`."
        },
        "opencodeHub.opencode.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Attach to an already running `opencode serve` (for example `http://127.0.0.1:4096`) instead of starting one."
        },
        "opencodeHub.opencode.serverPassword": {
          "type": "string",
          "default": "",
          "markdownDescription": "Password for the attached server (`OPENCODE_SERVER_PASSWORD`). Prefer the environment variable for shared settings."
        },
        "opencodeHub.approvals": {
          "type": "string",
          "enum": [
            "ask",
            "auto"
          ],
          "enumDescriptions": [
            "Ask before the agent runs commands, edits files or calls tools.",
            "Auto mode: the agent proceeds without asking (like the Claude app's auto mode)."
          ],
          "default": "ask",
          "scope": "application",
          "markdownDescription": "Whether the agent asks for approval before it acts. `auto` approves every tool call, command and edit without asking: opencode permission requests, Claude Code tool permissions, and MCP tools in Direct BYOK and Copilot. Codex never stops to ask; its `opencodeHub.codex.sandbox` decides what it may do. Switch from the chat with the Ask/Auto button, `/auto` or `/ask`. User setting only, so a workspace cannot turn it on."
        },
        "opencodeHub.sessions.keepDays": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "scope": "application",
          "markdownDescription": "Delete saved chat sessions that have not been used for this many days (checked when VS Code starts). `0` keeps them forever. The default, 30, matches Claude Code. Applies to Claude Code, Codex, Direct BYOK and Copilot sessions, which the extension stores in your VS Code profile on this computer; opencode keeps its own session history."
        },
        "opencodeHub.claudeCode.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `claude` executable. Leave empty to find it on `PATH`."
        },
        "opencodeHub.claudeCode.auth": {
          "type": "string",
          "enum": [
            "subscription",
            "apiKey"
          ],
          "enumDescriptions": [
            "Your Claude account (Pro / Max subscription), signed in with `claude auth login`. No per-token charges.",
            "An Anthropic API key stored in VS Code Secret Storage (billed per token)."
          ],
          "default": "subscription",
          "markdownDescription": "How Claude Code signs in. `subscription` (default) uses your Claude account and ignores `ANTHROPIC_API_KEY` in the environment so you are not billed per token by accident. Use `/login` in the chat to switch."
        },
        "opencodeHub.claudeCode.permissionMode": {
          "type": "string",
          "enum": [
            "default",
            "acceptEdits",
            "plan",
            "bypassPermissions"
          ],
          "default": "acceptEdits",
          "markdownDescription": "Permission mode passed to Claude Code. `default` denies anything that would prompt, `acceptEdits` allows file edits, `plan` is read-only, `bypassPermissions` allows everything."
        },
        "opencodeHub.claudeCode.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra model names or aliases to offer for Claude Code, after the list the CLI reports for your account. Any id the `claude` CLI accepts with `--model` works, for example `claude-opus-5` or `claude-sonnet-4-6`. *Add a model by name…* in the model picker adds to this list."
        },
        "opencodeHub.codex.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `codex` executable. Leave empty to find it on `PATH`."
        },
        "opencodeHub.codex.auth": {
          "type": "string",
          "enum": [
            "subscription",
            "apiKey"
          ],
          "enumDescriptions": [
            "Your ChatGPT account (Plus / Pro / Team plan), signed in with `codex login`. No per-token charges.",
            "An OpenAI API key stored in VS Code Secret Storage (billed per token)."
          ],
          "default": "subscription",
          "markdownDescription": "How Codex signs in. `subscription` (default) uses your ChatGPT account and ignores `CODEX_API_KEY` in the environment. Use `/login` in the chat to switch."
        },
        "opencodeHub.codex.sandbox": {
          "type": "string",
          "enum": [
            "read-only",
            "workspace-write",
            "danger-full-access"
          ],
          "default": "workspace-write",
          "description": "Sandbox policy passed to Codex."
        },
        "opencodeHub.codex.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra model names to offer for Codex, after the list the CLI reports for your account. *Add a model by name…* in the model picker adds to this list."
        },
        "opencodeHub.providers": {
          "type": "array",
          "default": [],
          "markdownDescription": "Direct BYOK providers. API keys are **not** stored here — use *OpenCode Hub: Manage BYOK Providers & API Keys…*.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique id, e.g. \"openrouter\"."
              },
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "openai-compatible",
                  "anthropic"
                ],
                "description": "Wire format."
              },
              "baseUrl": {
                "type": "string",
                "description": "API base URL, e.g. https://api.openai.com/v1 or http://localhost:11434/v1."
              },
              "models": {
                "type": "array",
                "description": "Model ids to offer. Leave empty to discover them from the provider's /models endpoint.",
                "items": {
                  "type": "string"
                }
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "pricing": {
                "type": "object",
                "description": "Optional USD price per million tokens keyed by model id, used for cost estimates.",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "number"
                    },
                    "output": {
                      "type": "number"
                    },
                    "cacheRead": {
                      "type": "number"
                    },
                    "cacheWrite": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        },
        "opencodeHub.mcp.servers": {
          "type": "object",
          "default": {},
          "markdownDescription": "MCP servers for the **Direct BYOK** and **Copilot** engines. (opencode, Claude Code and Codex use their own MCP configuration, which this extension reads and toggles.)",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "url": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "enabled": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "opencodeHub.avatar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the 3D companion in the chat view."
        },
        "opencodeHub.avatar.style": {
          "type": "string",
          "enum": [
            "buddy",
            "dots"
          ],
          "enumDescriptions": [
            "Oki, a small round creature that works, celebrates and sulks along with the agent.",
            "Five dots that rearrange themselves to show what is happening."
          ],
          "default": "buddy",
          "description": "Companion style."
        },
        "opencodeHub.usage.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the current session's token usage in the status bar."
        },
        "opencodeHub.usage.estimateCost": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Estimate what each reply costs when the engine reports tokens but no cost (Codex, and Direct BYOK providers such as OpenAI, Anthropic, Gemini, Groq, Mistral, DeepSeek, xAI, Together AI and Hugging Face). The estimate uses public list prices bundled with the extension; prices under `pricing` in `opencodeHub.providers` take precedence. With a subscription you are not billed per token, so the figure is what the same tokens would cost through the API."
        },
        "opencodeHub.systemPrompt": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "description": "Extra system prompt for the Direct BYOK and Copilot engines."
        },
        "opencodeHub.direct.maxContextTokens": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "**Direct BYOK:** send at most about this many tokens of earlier conversation with each request. `0` (default) sends the whole conversation and leaves out the oldest messages only when the provider reports that the model's context window is full. Set a number for local servers that cut long prompts without saying so (for example `8000` for an 8k model in Ollama or LM Studio). The newest message is always sent whole."
        },
        "opencodeHub.editor.quickFix": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer **Fix with OpenCode Hub** in the lightbulb menu on errors and warnings. The entries appear once the chat has been opened in the window."
        },
        "opencodeHub.chat.zoom": {
          "type": "number",
          "default": 1,
          "minimum": 0.8,
          "maximum": 1.6,
          "description": "Text scale of the chat view. 1 follows VS Code's font size."
        },
        "opencodeHub.chat.providerColors": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Tint the chat with the colour of the model's maker, so you can see at a glance who you are talking to: Claude orange, OpenAI green, Gemini blue, Copilot purple, local models grey. Shown as a strip along the top of the chat, the message box's border and a dot under the companion."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Get started with OpenCode Hub",
        "description": "Connect an engine, send your first message and learn the shortcuts.",
        "steps": [
          {
            "id": "open",
            "title": "Open the chat",
            "description": "The chat lives in the side bar. You can dock it on the right or open it as an editor tab.\n[Open Chat](command:opencodeHub.focus)",
            "media": {
              "markdown": "media/walkthrough/open.md"
            },
            "completionEvents": [
              "onCommand:opencodeHub.focus",
              "onView:opencodeHub.chat"
            ]
          },
          {
            "id": "engine",
            "title": "Choose an engine",
            "description": "opencode is the default. Claude Code, Codex, Direct BYOK and Copilot are one command away.\n[Select Engine](command:opencodeHub.selectEngine)",
            "media": {
              "markdown": "media/walkthrough/engine.md"
            },
            "completionEvents": [
              "onCommand:opencodeHub.selectEngine"
            ]
          },
          {
            "id": "signin",
            "title": "Sign in, or add a key",
            "description": "Use your Claude or ChatGPT subscription, or your own API keys. Keys stay in your keychain.\n[Sign In](command:opencodeHub.signIn)\n[Add a BYOK Provider](command:opencodeHub.manageProviders)",
            "media": {
              "markdown": "media/walkthrough/signin.md"
            },
            "completionEvents": [
              "onCommand:opencodeHub.signIn",
              "onCommand:opencodeHub.manageProviders"
            ]
          },
          {
            "id": "doctor",
            "title": "Check that everything works",
            "description": "See which engines are installed and ready on this machine.\n[Run Doctor](command:opencodeHub.doctor)",
            "media": {
              "markdown": "media/walkthrough/doctor.md"
            },
            "completionEvents": [
              "onCommand:opencodeHub.doctor"
            ]
          },
          {
            "id": "code",
            "title": "Ask about your code",
            "description": "Explain or fix a selection from the editor, and attach files with @.\n[Explain Selection](command:opencodeHub.explainSelection)",
            "media": {
              "markdown": "media/walkthrough/code.md"
            },
            "completionEvents": [
              "onCommand:opencodeHub.explainSelection",
              "onCommand:opencodeHub.fixSelection",
              "onCommand:opencodeHub.attachSelection"
            ]
          },
          {
            "id": "feedback",
            "title": "Tell us what is missing",
            "description": "Report a bug or share an idea. It opens a pre-filled GitHub issue that you review before it is sent.\n[Send Feedback](command:opencodeHub.sendFeedback)",
            "media": {
              "markdown": "media/walkthrough/feedback.md"
            },
            "completionEvents": [
              "onCommand:opencodeHub.sendFeedback"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
